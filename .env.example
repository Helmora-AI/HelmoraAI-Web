# Production server for a standalone Helmora-Web checkout
HELMORA_WEB_HOST=127.0.0.1
HELMORA_WEB_PORT=4173

# The built-in Web server reverse-proxies every Hub API/SSE request to this
# origin so browser cookies remain same-origin. Never put credentials here.
HELMORA_HUB_URL=http://127.0.0.1:3000

# Cloudflare Pages only (Pages Function bindings; ignored by npm start / Docker /
# Pterodactyl). Exact string "true" enables the fail-closed Hub proxy. On Pages,
# HELMORA_HUB_URL must be an exact HTTPS origin. Never use a VITE_ prefix and
# never place tunnel tokens, setup tokens, master keys or API keys here.
# HELMORA_CF_PAGES_PROXY_ENABLED=true
# HELMORA_HUB_URL=https://hub.example.com
